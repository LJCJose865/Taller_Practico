public class Numeros_Impares {
    public static void main(String[] args) throws Exception {
        System.out.println("Contador de Numeros Impares");

       

        for (int i = 1; i <= 50; i++){
            if( i % 2 != 0){
            
                System.out.println("Los numeros impares son " + i);
            }


        } 
    }
}
